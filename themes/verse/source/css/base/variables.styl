// ===========================
// CSS Variables - Design Tokens
// ===========================

:root
  // Colors
  --color-primary-500: hsl(195, 69%, 48%)
  --color-primary-600: hsl(195, 70%, 40%)

  // Background - Light mode
  --bg-primary: hsl(0, 0%, 98%)
  --bg-secondary: #ffffff
  --bg-tertiary: hsl(0, 0%, 95%)

  // Text - Light mode
  --text-primary: hsl(0, 0%, 10%)
  --text-secondary: hsl(0, 0%, 30%)
  --text-tertiary: hsl(0, 0%, 50%)

  // Border & Shadow
  --border-primary: hsl(0, 0%, 90%)
  --shadow-sm: 0 1px 2px rgba(0,0,0,0.05)
  --shadow-md: 0 4px 6px rgba(0,0,0,0.07)
  --shadow-lg: 0 10px 15px rgba(0,0,0,0.1)

  // Spacing
  --space-1: 0.25rem
  --space-2: 0.5rem
  --space-3: 0.75rem
  --space-4: 1rem
  --space-6: 1.5rem
  --space-8: 2rem
  --space-12: 3rem
  --space-16: 4rem

  // Border radius
  --radius-sm: 0.375rem
  --radius-md: 0.5rem
  --radius-lg: 0.75rem
  --radius-xl: 1rem

  // Typography - Fluid
  --font-size-xs: clamp(0.75rem, 0.7rem + 0.25vw, 0.875rem)
  --font-size-sm: clamp(0.875rem, 0.8rem + 0.35vw, 1rem)
  --font-size-base: clamp(1rem, 0.9rem + 0.5vw, 1.125rem)
  --font-size-lg: clamp(1.125rem, 1rem + 0.625vw, 1.375rem)
  --font-size-xl: clamp(1.25rem, 1.1rem + 0.75vw, 1.75rem)
  --font-size-2xl: clamp(1.75rem, 1.5rem + 1.25vw, 2.5rem)

  // Transitions
  --transition-fast: 0.15s ease
  --transition-base: 0.2s ease
  --transition-slow: 0.3s ease

// Dark mode
[data-theme="dark"]
  --bg-primary: hsl(220, 15%, 10%)
  --bg-secondary: hsl(220, 15%, 14%)
  --bg-tertiary: hsl(220, 15%, 18%)

  --text-primary: hsl(0, 0%, 95%)
  --text-secondary: hsl(0, 0%, 75%)
  --text-tertiary: hsl(0, 0%, 55%)

  --border-primary: hsl(220, 15%, 25%)
  --shadow-sm: 0 1px 2px rgba(0,0,0,0.3)
  --shadow-md: 0 4px 6px rgba(0,0,0,0.4)
  --shadow-lg: 0 10px 15px rgba(0,0,0,0.5)

  --color-primary-500: hsl(195, 85%, 60%)
