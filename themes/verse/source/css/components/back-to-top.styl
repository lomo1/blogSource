// ===========================
// Back to Top Button
// ===========================

#back-to-top
  position: fixed
  bottom: var(--space-8)
  right: var(--space-8)
  width: 50px
  height: 50px
  background: var(--color-primary-500)
  color: white
  border: none
  border-radius: 50%
  cursor: pointer
  display: flex
  align-items: center
  justify-content: center
  font-size: var(--font-size-lg)
  opacity: 0
  visibility: hidden
  transition: all var(--transition-slow)
  box-shadow: var(--shadow-lg)
  z-index: 99

  &:hover
    background: var(--color-primary-600)
    transform: translateY(-4px)

  &.visible
    opacity: 1
    visibility: visible

  .progress-indicator
    position: absolute
    top: -2px
    left: -2px
    right: -2px
    bottom: -2px
    border-radius: 50%
    border: 2px solid transparent
    border-top-color: white
    transform: rotate(0deg)

// Responsive
@media (max-width: 768px)
  #back-to-top
    bottom: var(--space-6)
    right: var(--space-6)
    width: 44px
    height: 44px
