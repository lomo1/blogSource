<% if (theme.tagcloud.enable && site.tags.length) { %>
  <div class="widget tagcloud-widget">
    <h3 class="widget-title"><%= __('tagcloud') %></h3>
    <div class="widget-content">
      <%- tagcloud({
        min_font: theme.tagcloud.min_font || 12,
        max_font: theme.tagcloud.max_font || 30,
        amount: theme.tagcloud.amount || 50,
        color: theme.tagcloud.color || false,
        start_color: theme.tagcloud.start_color || '#ccc',
        end_color: theme.tagcloud.end_color || '#111'
      }) %>
    </div>
  </div>
<% } %>
