<div class="page">
  <article class="page-article">
    <header class="page-header">
      <h1 class="page-title"><%= page.title %></h1>
      <% if (page.date) { %>
        <div class="page-meta">
          <time datetime="<%= page.date.toISOString() %>">
            <i class="far fa-calendar"></i>
            <%- date(page.date, 'YYYY-MM-DD') %>
          </time>
          <% if (page.updated && page.updated.valueOf() !== page.date.valueOf()) { %>
            <span class="separator">·</span>
            <time datetime="<%= page.updated.toISOString() %>">
              <i class="far fa-calendar-check"></i>
              <%= __('updated') %>: <%- date(page.updated, 'YYYY-MM-DD') %>
            </time>
          <% } %>
        </div>
      <% } %>
    </header>

    <div class="page-content">
      <%- page.content %>
    </div>

    <% if (theme.comments.enable && page.comments !== false) { %>
      <%- partial('_partial/comments') %>
    <% } %>
  </article>
</div>
