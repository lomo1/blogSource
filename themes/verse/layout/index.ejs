<div class="index-page">
  <div class="article-list">
    <% page.posts.each(function(post) { %>
      <%- partial('_partial/article', {post: post, index: true}) %>
    <% }); %>
  </div>

  <% if (page.total > 1) { %>
    <nav class="pagination">
      <%- paginator({
        prev_text: '← ' + __('prev_page'),
        next_text: __('next_page') + ' →',
        mid_size: 2,
        end_size: 1
      }) %>
    </nav>
  <% } %>
</div>
